# Environment
.vscode
.claude
.pytest_cache
*__pycache__*

# Test suite (should be automatically generated by each user)
tests/fixtures/*

# User specific: everything in user_info/ except the committed *_example files.
# Kept on disk on purpose (not deleted) so an older tag still runs from this tree.
user_info/*
!user_info/*_example.*
*.bak
# Legacy single-user SQLite database; only the one-off importer reads it.
db/joblister.db

# Temporary for Workflows
temp/
# Editable install metadata.
*.egg-info/
